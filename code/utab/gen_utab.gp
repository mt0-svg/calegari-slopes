\\ The table u_ij, 0 <= i, j <= 38, of the coefficients of F (Section 1 of the paper), packed one natural number per
\\ row, for the kernel check of Lemma 5.3: writes ../../CalegariSlopes/ADB/UTab.lean. The kernel checks the table
\\ against the recurrence u = N + (1 - Q) u (CalegariSlopes.ADB.Proof.rec_ok), so an error here fails in Lean.
\\ Run from this directory: gp -q gen_utab.gp < /dev/null > gen_utab.out
\\ u_ij for 1 <= i, j <= N from the recurrence of the denominator Q of F; numc is the numerator N.
numc(i, j) = if([i,j]==[1,1],90, [i,j]==[2,1],324, [i,j]==[1,2],648, [i,j]==[3,1],243, [i,j]==[2,2],486, [i,j]==[1,3],729, 0);
mkU(N) = {
  my(W = matrix(N + 3, N + 3));  \\ W[i+3, j+3] = u_ij, zero for i or j <= 0
  for(s = 2, 2*N, for(i = max(1, s-N), min(N, s-1), my(j = s - i, a = i + 3, b = j + 3);
    W[a, b] = numc(i, j) + 270*W[a-1, b-1] + 972*W[a-2, b-1] + 972*W[a-1, b-2]
              + 729*W[a-3, b-1] + 729*W[a-2, b-2] + 729*W[a-1, b-3]));
  matrix(N, N, i, j, W[i+3, j+3])
};
NN = 38;
U = mkU(NN);
u(i, j) = if(i < 1 || j < 1, 0, U[i, j]);
maxb = 0; for(i = 1, NN, for(j = 1, NN, if(U[i,j], maxb = max(maxb, exponent(U[i,j]) + 1))));
print("max bits of u_ij, i, j <= ", NN, ": ", maxb);
K = 336;
if(maxb >= K, error("slot too small"));
for(i = 0, NN, for(j = 0, NN, if(u(i, j) < 0, error("negative entry"))));
print("slot width K = ", K);
packed(i) = sum(j = 0, NN, u(i, j) * 2^(K * j));
F1 = "../../CalegariSlopes/ADB/UTab.lean";
system(concat("rm -f ", F1));
write(F1, "/-\nCopyright (c) 2026 mt0-svg. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: mt0-svg\n-/\nmodule\n\n@[expose] public section\n");
write(F1, "/-!\n# The table of `u_ij`, `0 ≤ i, j ≤ 38` (data for the kernel checks of Lemma 5.3)\n\nGenerated by `code/utab/gen_utab.gp`; row `i` packed as `Σ_j u_ij 2^(K j)`. Checked against the recurrence\nof `u` in the kernel (`CalegariSlopes.ADB.Proof.rec_ok`), so nothing here is trusted.\n-/\n");
write(F1, "namespace CalegariSlopes.ADB.Tab\n");
write(F1, "/-- Slot width of the packed rows. -/");
write(F1, "def K : Nat := ", K, "\n");
write(F1, "/-- Row `i` packed: `Σ_j u_ij 2^(K j)`. -/");
write(F1, "def uPacked : Nat → Nat");
for(i = 0, NN, write(F1, "  | ", i, " => 0x", Strprintf("%x", packed(i))));
write(F1, "  | _ => 0\n");
write(F1, "/-- The entry `(i, j)` of the table. -/");
write(F1, "def tab (i j : Nat) : Nat := (uPacked i >>> (K * j)) % 2 ^ K\n");
write(F1, "end CalegariSlopes.ADB.Tab");
print("written ", F1);
quit
